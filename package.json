{
	"name": "wie-spaet-ist-zu-spaet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.14.1"
		},
		"packageManager": {
			"name": "npm",
			"version": "11.12.1"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"data:build": "uv run --project pipeline python pipeline/build.py",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"minotor": "^11.5.0"
	}
}
